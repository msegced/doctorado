  },
  "contents": [
    {
      "@type": "Property",
      "name": "staffToken",
      "displayName": {
        "en": "staff token"
      },
      "description": {
        "en": "Pseudonymous identifier of the staff member."
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "windowStart",
      "displayName": {
        "en": "window start"
      },
      "description": {
        "en": "Start of the time window (UTC)."
      },
      "schema": "dateTime",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "windowEnd",
      "displayName": {
        "en": "window end"
      },
      "description": {
        "en": "End of the time window (UTC)."
      },
      "schema": "dateTime",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "value",
      "displayName": {
        "en": "workload index"
      },
      "description": {
        "en": "Workload index value in [0,1]."
      },
      "schema": "double",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "method",

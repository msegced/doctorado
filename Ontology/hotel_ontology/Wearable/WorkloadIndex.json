        "valueSchema": "string",
        "enumValues": [
          {
            "name": "RuleBased",
            "enumValue": "RuleBased"
          },
          {
            "name": "DataDriven",
            "enumValue": "DataDriven"
          }
        ]
      },
      "writable": false
    },
    {
      "@type": "Property",
      "name": "featureVectorJson",
      "displayName": {
        "en": "feature vector (JSON)"
      },
      "description": {
        "en": "Optional JSON-encoded feature vector used to compute this index."
